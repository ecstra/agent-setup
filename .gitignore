# Worktrees are disabled (.agents/SYSTEM.md, rule 10.2). The one
# sanctioned home, if the owner ever asks, is this folder, and its
# contents never enter git.
.agents/.worktrees/

# Secrets live in .env and never enter git. An .env.example stays
# tracked, so a fresh clone knows which keys it needs.
.env
.env.*
!.env.example

# The brain tool keeps the owner's standing word to proceed, the auto
# ack with its end, in this file. It belongs to one machine and one
# stretch of work, so it never enters git, and neither does the
# temporary file the tool writes it through.
.agents/.ack
.agents/..ack.*.tmp

# The brain tool keeps the owner's word to change a test file's
# assertions, each file with its end, in this file. It belongs to one
# machine and one stretch of work too, so it never enters git, and
# neither does its write in flight.
.agents/.ack-tests
.agents/..ack-tests.*.tmp

# The brain tool keeps the current work, the chain from the plan down
# to the step the agent is on, in this file. It belongs to one machine
# too, so it never enters git, and neither does its write in flight.
.agents/.task
.agents/..task.*.tmp

# The brain tool keeps the conclude word, the time the session wraps
# itself up, in this file. It belongs to one machine too, so it never
# enters git, and neither does its write in flight.
.agents/.conclude
.agents/..conclude.*.tmp

# A line of work started beside the folder's own keeps its current
# work, its standing word and its conclude word in a folder of its own
# under this one, with a mark for each session that is on it. They
# belong to one machine as those three files do, so the folder never
# enters git.
.agents/.lines

# The brain tool writes the one note a session leaves for the next in
# this folder, through brain handover, and the session start hook reads
# it once and removes it, with the copy it reads and the lock beside it.
# It belongs to one machine and one stretch of work too, so the folder
# never enters git, and with no slash after its name neither does a link
# that stands in the folder's place.
.agents/.handover

# The folder the note lived in before 2.2.0 stays ignored, so a note an
# older session left there never enters git before a session start moves
# it into the hidden folder.
.agents/handover

# Python leaves compiled bytecode beside the brain tool, and ruff its
# cache. Neither ever ships.
__pycache__/
*.pyc
.ruff_cache/

# Claude Code keeps one person's own settings here. The shared ones are
# in .claude/settings.json, which does ship.
.claude/settings.local.json
