{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR\"/.agents/skills/agent-brain/scripts/hooks.py session-start --agent gemini"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR\"/.agents/skills/agent-brain/scripts/hooks.py prompt --agent gemini"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR\"/.agents/skills/agent-brain/scripts/hooks.py pre-write --agent gemini"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR\"/.agents/skills/agent-brain/scripts/hooks.py post-write --agent gemini"
          }
        ]
      },
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR\"/.agents/skills/agent-brain/scripts/hooks.py tick --agent gemini"
          }
        ]
      }
    ]
  }
}
